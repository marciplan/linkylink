// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BundelType {
  NORMAL
  YEAR_REVIEW
}

enum CategoryType {
  BEST
  WORST
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  username                 String                    @unique
  password                 String
  name                     String?
  image                    String?
  /// Uploaded profile photo (256px WebP/JPEG), served from /api/photo/[id]; `image` then points there.
  photo                    Bytes?
  photoType                String?
  linkylinks               LinkLink[]
  dismissedRecommendations DismissedRecommendation[]
  comments                 Comment[]
  activities               Activity[]
  emailFollowers           EmailFollow[]
  mcpGrants                McpGrant[]
  blockedSites             BlockedSite[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model LinkLink {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String       @unique
  title        String
  subtitle     String?
  avatar       String?
  headerImage  String?
  headerPrompt String?
  headerImages String[]
  links        Link[]
  type         BundelType   @default(NORMAL)
  year         Int?
  categories   Category[]
  views        Int          @default(0)
  isPublic     Boolean      @default(true)
  ask          Ask?
  votes        Vote[]
  suggestions  Suggestion[]
  remixOf      Remix?       @relation("RemixCopy")
  remixes      Remix[]      @relation("RemixSource")
  subBundelOf  SubBundel?   @relation("SubBundelChild")
  subBundels   SubBundel[]  @relation("SubBundelParent")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Link {
  id                       String                    @id @default(cuid())
  linkylinkId              String
  linkylink                LinkLink                  @relation(fields: [linkylinkId], references: [id], onDelete: Cascade)
  title                    String
  url                      String
  favicon                  String?
  context                  String?
  order                    Int
  clicks                   Int                       @default(0)
  likes                    Int                       @default(0)
  createdAt                DateTime                  @default(now())
  dismissedRecommendations DismissedRecommendation[]
  comments                 Comment[]
  votes                    Vote[]
  subBundels               SubBundel[]
}

model DismissedRecommendation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, linkId])
  @@index([userId])
}

model Category {
  id           String         @id @default(cuid())
  linkylinkId  String
  linkylink    LinkLink       @relation(fields: [linkylinkId], references: [id], onDelete: Cascade)
  name         String
  icon         String         @default("Star")
  categoryType CategoryType   @default(BEST)
  order        Int
  rankLimit    Int            @default(5)
  items        CategoryItem[]
  createdAt    DateTime       @default(now())

  @@index([linkylinkId])
}

model CategoryItem {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  url        String
  favicon    String?
  context    String?
  rank       Int
  clicks     Int      @default(0)
  likes      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Sharing features. These live in their own tables (nothing is added to the
// existing ones) so the app keeps working until `prisma db push` has run.
// ---------------------------------------------------------------------------

enum AskKind {
  PICK_ONE
  PICK_ANY
}

/// A Bundel that asks visitors to vote (and optionally suggest links).
model Ask {
  linkylinkId      String   @id
  linkylink        LinkLink @relation(fields: [linkylinkId], references: [id], onDelete: Cascade)
  kind             AskKind  @default(PICK_ONE)
  question         String?
  allowSuggestions Boolean  @default(false)
  closed           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// One visitor's vote for one link. Visitors are identified by a random key
/// kept on their device, so voting needs no account.
model Vote {
  id          String   @id @default(cuid())
  linkylinkId String
  linkylink   LinkLink @relation(fields: [linkylinkId], references: [id], onDelete: Cascade)
  linkId      String
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  voterKey    String
  voterName   String
  createdAt   DateTime @default(now())

  @@unique([linkId, voterKey])
  @@index([linkylinkId])
}

/// A link a visitor proposed for someone else's Bundel, waiting for the owner.
model Suggestion {
  id          String   @id @default(cuid())
  linkylinkId String
  linkylink   LinkLink @relation(fields: [linkylinkId], references: [id], onDelete: Cascade)
  url         String
  title       String
  note        String?
  name        String
  voterKey    String
  createdAt   DateTime @default(now())

  @@index([linkylinkId])
}

/// Credit for "Save a copy": which Bundel a copy came from.
model Remix {
  copyId    String    @id
  copy      LinkLink  @relation("RemixCopy", fields: [copyId], references: [id], onDelete: Cascade)
  sourceId  String?
  source    LinkLink? @relation("RemixSource", fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([sourceId])
}

enum ActivityKind {
  VOTE
  SUGGESTION
  REMIX
  COMMENT
  FOLLOW
}

/// Something a real person did with your Bundel. Shown on Home; nothing else.
model Activity {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ActivityKind
  actorName   String
  bundelTitle String?
  bundelPath  String?
  detail      String?
  read        Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
}

/// Opt-in email updates for a curator's new links (double opt-in).
model EmailFollow {
  id          String    @id @default(cuid())
  email       String
  followeeId  String
  followee    User      @relation(fields: [followeeId], references: [id], onDelete: Cascade)
  token       String    @unique
  confirmedAt DateTime?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([email, followeeId])
}

// ---------------------------------------------------------------------------
// AI connections (MCP). New tables only, like the sharing features above, so
// the app keeps working until `prisma db push` has run. See docs/mcp-plan.md.
// ---------------------------------------------------------------------------

/// A Bundel that an AI activity made, hanging under a link in another Bundel.
/// The child is a normal Bundel; this row only records where it hangs.
model SubBundel {
  childId      String   @id
  child        LinkLink @relation("SubBundelChild", fields: [childId], references: [id], onDelete: Cascade)
  parentId     String
  parent       LinkLink @relation("SubBundelParent", fields: [parentId], references: [id], onDelete: Cascade)
  sourceLinkId String?
  sourceLink   Link?    @relation(fields: [sourceLinkId], references: [id], onDelete: SetNull)
  activity     String
  createdAt    DateTime @default(now())

  @@index([parentId])
  @@index([sourceLinkId])
}

/// One AI app connected to a user's account, optionally limited to one Bundel.
model McpGrant {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundelId             String?
  clientId             String
  clientName           String
  redirectHost         String?
  scopes               String
  resource             String
  accessTokenHash      String?   @unique
  accessExpiresAt      DateTime?
  refreshTokenHash     String?   @unique
  prevRefreshTokenHash String?   @unique
  lastUsedAt           DateTime?
  revokedAt            DateTime?
  callsDay             String?
  callsCount           Int       @default(0)
  createdAt            DateTime  @default(now())

  @@index([userId])
}

/// One-time sign-in codes handed to an AI app after the user approves it.
model McpAuthCode {
  codeHash      String    @id
  userId        String
  bundelId      String?
  clientId      String
  clientName    String
  redirectUri   String
  codeChallenge String
  resource      String
  scopes        String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

/// AI apps that registered themselves (Dynamic Client Registration).
/// Apps using a Client ID Metadata Document need no row here.
model McpClient {
  id           String   @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())
}

/// An activity in progress: ties the later save_results call to the user,
/// the link it started from and the activity.
model McpRun {
  id        String   @id @default(cuid())
  grantId   String
  userId    String
  linkId    String
  activity  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([grantId])
}

/// Websites a user never wants in AI activity results.
model BlockedSite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain    String
  createdAt DateTime @default(now())

  @@unique([userId, domain])
}
